# ---------- App ----------
APP_URL=http://localhost:3000
# Random string, 32+ characters. Signs login sessions.
SESSION_SECRET=
# Base64 of exactly 32 random bytes. Encrypts creators' Stripe keys.
ENCRYPTION_KEY=

# ---------- Database (Postgres) ----------
# A database you can throw away: the app creates and alters tables on its first connection.
# With `docker compose up -d db` this is postgres://postgres:postgres@localhost:5432/buymeatokens
# Never paste a production URL here (and never use `vercel env pull` to fill this file).
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/buymeatokens
# Outside a deployment, schema changes only go to a local host (localhost, 127.x, a docker service name).
# Set to 1 to allow a remote development database, such as your own free Supabase project.
ALLOW_REMOTE_SCHEMA=

# ---------- GitHub login ----------
# https://github.com/settings/developers -> New OAuth App
# Callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- GitHub API (optional) ----------
# Raises the GitHub API rate limit for repo stats on creator pages and the Contributor badge.
# A fine-grained token with no permissions is enough.
GITHUB_TOKEN=
# Whose contributors get the Contributor badge (default Renanuya/buymeatokens-oss), plus extra logins.
OSS_REPO=
CONTRIBUTOR_LOGINS=

# ---------- USDC on Base (optional) ----------
# Your own Base RPC endpoint, tried before the public ones.
BASE_RPC_URL=

# ---------- Search engines (optional) ----------
# Verification meta tags, if you verify with a tag instead of DNS.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ---------- Local development helpers (ignored in production) ----------
# Lets you log in without GitHub on the login page.
DEV_LOGIN=true

# ---------- Cron ----------
# Protects /api/cron/reconcile (sent as "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=
# Separate secret for the Supabase minute worker at /api/cron/emails.
EMAIL_CRON_SECRET=

# ---------- Early access ----------
# New pages earn lifetime free access while true (default).
# Set false to stop granting the benefit; previously earned benefits remain.
EARLY_ACCESS_OPEN=true
# Optional application gate; independent of the lifetime benefit (default: false).
GATED_SIGNUPS=false
# GitHub logins that can review applications at /admin (comma separated).
ADMIN_GITHUB_LOGINS=

# ---------- New registration welcome + one-hour setup reminder ----------
# Verify buymeatokens.com in your provider before enabling. Never commit real keys.
EMAIL_PROVIDER=mailjet
EMAIL_LIVE_ENABLED=false
EMAIL_TEST_TO=
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
# Optional alternative: EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=buymeatokens <hello@buymeatokens.com>
# A mailbox you actually read; replies do not require an inbound mailbox on the sender domain.
EMAIL_REPLY_TO=
# Where server errors and payment problems are mailed (src/lib/ops.ts). Empty: EMAIL_TEST_TO gets them.
OPS_ALERT_TO=

# ---------- "Write with AI" (the project description, drafted from the repo's README, or from the saved project details without a repo) ----------
# Off unless at least one key is set; then the buttons show in the guided setup and on /dashboard/settings.
# Tried in this order, the next one when a call fails (quota, outage). Both have free tiers.
# Gemini: https://aistudio.google.com/apikey  (free-tier prompts may be used by Google; READMEs and the page details sent without a repo are public anyway).
# The free tier only works in a project with no billing attached; a prepaid project answers 402 once its credit is used.
GEMINI_API_KEY=
# Optional, default gemini-3.5-flash-lite.
GEMINI_MODEL=
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Optional, comma-separated, tried in order. Default qwen/qwen3.8-27b,openai/gpt-oss-120b. Each model has its own
# free quota (8,000 tokens a minute, 1,000 requests a day), so the second one covers drafts that come close together.
GROQ_MODELS=
# Drafts everyone together can ask for per 24 hours (default 1000). Each creator gets 10 a day.
AI_DRAFTS_DAILY_CAP=
